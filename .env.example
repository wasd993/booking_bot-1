# ── Обязательные ────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram ID администраторов через запятую (без пробелов)
# Узнать свой ID: @userinfobot
ADMIN_IDS=123456789

# ── Оплата ──────────────────────────────────────────────────
# Стоимость записи в Telegram Stars (целое число)
STARS_PRICE=10

# ── База данных ─────────────────────────────────────────────
# Путь к файлу SQLite (по умолчанию bot.db в корне проекта)
DB_PATH=bot.db
